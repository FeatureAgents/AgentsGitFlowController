{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node ${CLAUDE_PROJECT_DIR}/bin/gitflow-guard.mjs check --platform claude" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node ${CLAUDE_PROJECT_DIR}/bin/gitflow-guard.mjs check --platform claude" }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node ${CLAUDE_PROJECT_DIR}/bin/gitflow-guard.mjs check --platform claude" }
        ]
      }
    ]
  }
}

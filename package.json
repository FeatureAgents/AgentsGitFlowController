{
  "name": "agents-gitflow-guard",
  "version": "0.0.26",
  "description": "A configurable branch-role guard for AI coding agents (DSH / Claude Code / Codex / OpenCode / Antigravity / Pi) — zero-config defaults (develop+main) out of the box, deep-merge override, and per-client native hooks via gitflow-guard wire/setup; integration/preview/production/archive, each with its own update rules",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "patch.yml",
    "pi",
    "opencode",
    "README.md",
    "README.zh.md",
    "README.ja.md",
    "README.de.md",
    "README.fr.md",
    "README.it.md",
    "README.pt.md",
    "README.es.md"
  ],
  "bin": {
    "gitflow-guard": "bin/gitflow-guard.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "claude-code",
    "codex",
    "opencode",
    "antigravity",
    "pi",
    "pi-agent",
    "pi-extension",
    "plugin",
    "hook",
    "gitflow",
    "git",
    "workflow",
    "guard",
    "agent",
    "zero-config",
    "onboarding",
    "wire",
    "setup"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/FeatureAgents/AgentsGitFlowController.git"
  },
  "bugs": {
    "url": "https://github.com/FeatureAgents/AgentsGitFlowController/issues"
  },
  "homepage": "https://github.com/FeatureAgents/AgentsGitFlowController#readme",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:platforms": "npm run build && node scripts/verify-matrix.mjs",
    "test:git-matrix": "bash scripts/test-git-matrix.sh",
    "test:realflow": "bash scripts/test-git-realflow.sh",
    "test:pi": "bash scripts/test-pi-extension.sh",
    "test:all": "npm run typecheck && npm test && npm run test:platforms && npm run test:git-matrix && npm run test:realflow",
    "typecheck": "tsc --noEmit",
    "verify:matrix": "npm run build && node scripts/verify-matrix.mjs",
    "check:pins": "node scripts/check-version-pins.mjs",
    "prepublishOnly": "npm run check:pins"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5",
    "@types/node": "^22",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}

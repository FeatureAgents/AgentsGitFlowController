{
  "name": "@freehappyteam/dsh-gitflow-guard",
  "version": "0.1.0",
  "description": "DSH 插件: 基于本地 git 事实强制 feature → 预览 → 基线 的合入顺序, 用户唯一例外权",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "patch.yml",
    "README.md"
  ],
  "bin": {
    "gitflow-guard": "bin/gitflow-guard.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5",
    "@types/node": "^22",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
